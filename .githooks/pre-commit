#!/usr/bin/env bash
# Pre-commit secret guard. Enable once per clone/worktree:
#   git config core.hooksPath .githooks
# Scans only the staged (added/copied/modified) files via the shared scanner.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)
[ "${#staged[@]}" -eq 0 ] && exit 0
bash "$ROOT/scripts/secret-scan.sh" "${staged[@]}"
