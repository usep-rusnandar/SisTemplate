{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SSO": {
    "Enabled": false,
    "SsoUrl": "",
    "HomeUrl": "",
    "ApplicationUrl": "https://your-app-name.azurewebsites.net/",
    "AllowedApplicationUrls": [
      "https://your-app-name.azurewebsites.net/"
    ],
    "Application": "SisTemplate"
  },
  "Auth": {
    "AllowPasswordlessDevLogin": false
  },
  "AzureBlob": {
    "ServiceUri": "https://<your-storage-account>.blob.core.windows.net",
    "Containers": {
      "platformUser": "app-platform-users"
    }
  },
  "SharePoint": {
    "TenantId": "",
    "ClientId": "",
    "ManagedIdentityClientId": "",
    "DownloadTimeoutSeconds": 90
  },
  "Frontend": {
    "InternalUrl": "https://your-app-name.azurewebsites.net",
    "InternalDistPath": ""
  }
}
