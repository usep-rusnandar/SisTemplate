<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / App Service request filtering for multipart document uploads.
     SDK Web projects do not emit maxAllowedContentLength by default; without it, large
     vendor PDFs can be cut off by the host before ASP.NET Core sees the full body. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 32 MB — covers largest vendor doc slots (10 MB) + multipart overhead. -->
        <requestLimits maxAllowedContentLength="33554432" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
