<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IntegratedProcurement.VendorGateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <!-- Public vendor edge: serves the built vendor SPA (frontend/dist/external) and reverse-proxies
       allowlisted /api paths to AppHost. Build first: npm run build:external -->
  <Target Name="RequireVendorFrontend" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(SkipVendorFrontend)' != 'true'">
    <Error Condition="!Exists('..\..\..\frontend\dist\external\index.html')"
           Text="Vendor gateway publish needs frontend/dist/external. Run: npm run build:external" />
  </Target>
  <Target Name="PublishVendorFrontend" AfterTargets="ComputeFilesToPublish"
          Condition="Exists('..\..\..\frontend\dist\external')">
    <ItemGroup>
      <_VendorFrontendFiles Include="..\..\..\frontend\dist\external\**" />
      <ResolvedFileToPublish Include="@(_VendorFrontendFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
