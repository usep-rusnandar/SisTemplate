<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IntegratedProcurement.ModuleGateway</RootNamespace>
    <FrontendPortal Condition="'$(FrontendPortal)' == ''"></FrontendPortal>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <!-- Module portal edge: serves frontend/dist/<portal> and reverse-proxies allowlisted /api
       paths to AppHost. Build first: npm run build:<portal>. Pass -p:FrontendPortal=<portal>. -->
  <Target Name="RequireModuleFrontend" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(SkipModuleFrontend)' != 'true'">
    <Error Condition="'$(FrontendPortal)' == ''"
           Text="ModuleGateway publish needs -p:FrontendPortal=vendor-onboarding|proposal-tracker|contract-monitoring" />
    <Error Condition="!Exists('..\..\..\frontend\dist\$(FrontendPortal)\index.html')"
           Text="Module gateway publish needs frontend/dist/$(FrontendPortal). Run: npm run build:$(FrontendPortal)" />
  </Target>
  <Target Name="PublishModuleFrontend" AfterTargets="ComputeFilesToPublish"
          Condition="'$(FrontendPortal)' != '' And Exists('..\..\..\frontend\dist\$(FrontendPortal)')">
    <ItemGroup>
      <_ModuleFrontendFiles Include="..\..\..\frontend\dist\$(FrontendPortal)\**" />
      <ResolvedFileToPublish Include="@(_ModuleFrontendFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
